{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:antimars:schema:1.0",
  "title": "Antimars · Core 1.0 · json block",
  "description": "The <json> block of an Antimars output. Lengths (2 to 4 steps, 90 characters for the code) are checked by tools/antimars.py as warnings; the schema only fixes what a machine must be able to read. Keys and enum values are the 1.0 wire format and stay in French (glossary in SPEC.md).",
  "type": "object",
  "properties": {
    "antimars": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$"
    },
    "statut": {
      "enum": [
        "monte",
        "question_plus_juste",
        "voie_courte"
      ]
    },
    "interpretation": {
      "type": "object",
      "required": [
        "entendue",
        "energie",
        "pensee",
        "abstraction",
        "vivant",
        "enjeu"
      ],
      "properties": {
        "entendue": {
          "$ref": "#/$defs/texte"
        },
        "energie": {
          "$ref": "#/$defs/texte"
        },
        "pensee": {
          "$ref": "#/$defs/texte"
        },
        "abstraction": {
          "$ref": "#/$defs/texte"
        },
        "vivant": {
          "$ref": "#/$defs/texte"
        },
        "enjeu": {
          "$ref": "#/$defs/texte"
        },
        "poids": {
          "type": "object",
          "properties": {
            "energie": {
              "$ref": "#/$defs/poids"
            },
            "pensee": {
              "$ref": "#/$defs/poids"
            },
            "abstraction": {
              "$ref": "#/$defs/poids"
            },
            "vivant": {
              "$ref": "#/$defs/poids"
            }
          }
        }
      }
    },
    "canon": {
      "type": "object",
      "required": [
        "homme",
        "planete",
        "vivant"
      ],
      "properties": {
        "homme": {
          "$ref": "#/$defs/sceau"
        },
        "planete": {
          "$ref": "#/$defs/sceau"
        },
        "vivant": {
          "$ref": "#/$defs/sceau"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "proto": {
      "type": "string"
    },
    "raisonnement": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/texte"
      }
    },
    "reponse": {
      "$ref": "#/$defs/texte"
    },
    "solution": {
      "$ref": "#/$defs/texte"
    },
    "code": {
      "type": "string",
      "pattern": "^[^\\n\\r]*$"
    },
    "piliers": {
      "type": "object",
      "properties": {
        "geometrie": {
          "$ref": "#/$defs/poids"
        },
        "rationalite": {
          "$ref": "#/$defs/poids"
        },
        "creativite": {
          "$ref": "#/$defs/poids"
        },
        "paix": {
          "$ref": "#/$defs/poids"
        }
      }
    },
    "echanges": {
      "type": "object",
      "properties": {
        "geometrie_rationalite": {
          "$ref": "#/$defs/poids"
        },
        "rationalite_creativite": {
          "$ref": "#/$defs/poids"
        },
        "creativite_paix": {
          "$ref": "#/$defs/poids"
        },
        "paix_geometrie": {
          "$ref": "#/$defs/poids"
        }
      }
    }
  },
  "required": [
    "reponse"
  ],
  "if": {
    "properties": {
      "statut": {
        "const": "voie_courte"
      }
    },
    "required": [
      "statut"
    ]
  },
  "else": {
    "required": [
      "interpretation",
      "canon",
      "raisonnement",
      "solution"
    ]
  },
  "$defs": {
    "texte": {
      "type": "string",
      "pattern": "\\S"
    },
    "poids": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sceau": {
      "type": "object",
      "required": [
        "sceau",
        "pourquoi"
      ],
      "properties": {
        "sceau": {
          "enum": [
            -1,
            0,
            1
          ]
        },
        "pourquoi": {
          "type": "string"
        }
      }
    }
  }
}
